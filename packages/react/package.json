{
  "name": "@tabmesh/react",
  "version": "0.0.1",
  "description": "React hooks for TabMesh - cross-tab event mesh",
  "keywords": ["react", "hooks", "cross-tab", "tabmesh", "event mesh"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "peerDependencies": {
    "@tabmesh/core": "^0.0.1",
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@tabmesh/core": "workspace:*",
    "@testing-library/react": "^14.0.0",
    "@types/react": "^18.2.0",
    "jsdom": "^23.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.2.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tabmesh/tabmesh.git",
    "directory": "packages/react"
  },
  "homepage": "https://tabmesh.dev",
  "author": "TabMesh Contributors",
  "license": "MIT"
}
