{
  "name": "@tabmesh/core",
  "version": "0.0.1",
  "description": "Frontend event mesh for cross-tab coordination, leader election, and shared backend connections",
  "keywords": [
    "cross-tab",
    "browser tabs",
    "leader election",
    "event mesh",
    "broadcast channel",
    "web locks",
    "tab coordination"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./leader": {
      "import": "./dist/leader/index.js",
      "types": "./dist/leader/index.d.ts"
    },
    "./bus": {
      "import": "./dist/bus/index.js",
      "types": "./dist/bus/index.d.ts"
    },
    "./storage": {
      "import": "./dist/storage/index.js",
      "types": "./dist/storage/index.d.ts"
    },
    "./transport": {
      "import": "./dist/transport/index.js",
      "types": "./dist/transport/index.d.ts"
    },
    "./service-worker": {
      "import": "./dist/service-worker/index.js",
      "types": "./dist/service-worker/index.d.ts"
    },
    "./worker.js": "./dist/tabmesh-worker.js",
    "./sw.js": "./dist/tabmesh-sw.js"
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc && vite build && node scripts/build-bundles.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.28.0",
    "jsdom": "^23.0.0",
    "typescript": "^5.2.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tabmesh/tabmesh.git",
    "directory": "packages/core"
  },
  "homepage": "https://tabmesh.dev",
  "bugs": "https://github.com/tabmesh/tabmesh/issues",
  "author": "TabMesh Contributors",
  "license": "MIT"
}
