{
  "name": "@tabmesh/transport-websocket",
  "version": "0.0.1",
  "description": "WebSocket transport adapter for TabMesh",
  "keywords": ["websocket", "transport", "tabmesh", "real-time"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "peerDependencies": {
    "@tabmesh/core": "^0.0.1"
  },
  "dependencies": {},
  "devDependencies": {
    "@tabmesh/core": "workspace:*",
    "typescript": "^5.2.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tabmesh/tabmesh.git",
    "directory": "packages/transport-websocket"
  },
  "homepage": "https://tabmesh.dev",
  "author": "TabMesh Contributors",
  "license": "MIT"
}
